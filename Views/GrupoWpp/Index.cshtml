@{
    ViewBag.Title = "Index";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ================== SEO ================== -->
    <title>Tropa do Filipe Barros | Movimento Oficial - Deputado Federal</title>
    <meta name="description" content="Entre no grupo oficial da sua cidade e acompanhe em primeira mão todas as novidades, ações e informações do mandato do Filipe Barros, Deputado Federal pelo Ceará." />
    <meta name="keywords" content="Filipe Barros, Deputado Federal, Ceará, Tropa do Filipe Barros, movimento, grupo WhatsApp, política, mandato" />
    <meta name="author" content="Tropa do Filipe Barros" />
    <meta name="robots" content="index, follow" />

    <!-- ============ Open Graph / WhatsApp / Facebook ============ -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tropa do Filipe Barros | Entre no Movimento Oficial" />
    <meta property="og:description" content="Faça parte da Tropa do Filipe Barros. Entre no grupo da sua cidade e acompanhe tudo em primeira mão." />
    <meta property="og:image" content="" />
    <meta property="og:url" content="" />
    <meta property="og:locale" content="pt_BR" />

    <!-- ============ Twitter Card ============ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tropa do Filipe Barros | Movimento Oficial" />
    <meta name="twitter:description" content="Entre no grupo oficial da sua cidade e acompanhe o mandato em primeira mão." />
    <meta name="twitter:image" content="" />

    <!-- ============ Fonte Montserrat ============ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        /* ===================== RESET ===================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #001f08;
            color: #fff;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ===================== HERO ===================== */
        /* Fundo verde Brasil mais escuro: verde médio-escuro no centro -> verde bem escuro nas bordas */
        .hero {
            min-height: 100vh;
            background: radial-gradient(ellipse at center, #00350f 0%, #001f08 55%, #000a03 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            position: relative;
            overflow: hidden;
        }

            /* Textura sutil opcional para dar profundidade */
            .hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle at 20% 30%, rgba(255,223,0,0.08) 0%, transparent 40%), radial-gradient(circle at 80% 70%, rgba(0,39,118,0.15) 0%, transparent 50%);
                pointer-events: none;
            }

        .container {
            width: 100%;
            max-width: 1200px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        /* ===================== COLUNA ESQUERDA ===================== */
        .left {
            animation: fadeSlideUp 0.9s ease-out both;
        }

        /* Badge "MOVIMENTO OFICIAL" */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #fff;
            margin-bottom: 36px;
            animation: pulseBadge 2.5s ease-in-out infinite;
        }

            .badge svg {
                width: 16px;
                height: 16px;
            }

        /* Animação de pulso suave no badge */
        @@keyframes pulseBadge {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(255, 223, 0, 0.4);
                transform: scale(1);
            }

            50% {
                box-shadow: 0 0 0 12px rgba(255, 223, 0, 0);
                transform: scale(1.02);
            }
        }

        /* Título principal */
        .title {
            font-size: clamp(2.2rem, 5.5vw, 4.5rem);
            font-weight: 900;
            line-height: 1.15;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin-bottom: 32px;
            color: #fff;
        }

            .title .highlight {
                color: #FFDF00;
                display: block;
                text-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
                margin-top: 16px;
                line-height: 1.1;
            }

        /* Parágrafo descritivo */
        .description {
            font-size: clamp(1rem, 1.4vw, 1.15rem);
            color: rgba(255, 255, 255, 0.75);
            max-width: 520px;
            font-weight: 500;
        }

        /* ===================== COLUNA DIREITA ===================== */
        .right {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
            animation: fadeSlideUp 0.9s ease-out 0.2s both;
        }

        /* Foto de perfil */
        .photo-wrap {
            width: 100%;
            max-width: 420px;
            aspect-ratio: 3 / 2;
            border-radius: 20px;
            overflow: hidden;
            border: 4px solid #FFDF00;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 8px 20px rgba(0, 0, 0, 0.3);
            background: #002776;
        }

            .photo-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: left center;
                transform: scale(1.22);
                transform-origin: left center;
                display: block;
            }

        /* Card do formulário */
        .form-card {
            width: 100%;
            max-width: 420px;
            background: #FFFFFF;
            border-radius: 20px;
            padding: 28px 24px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
            color: #1a1a1a;
            position: relative;
        }

        .form-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: #FFDF00;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            box-shadow: 0 6px 16px rgba(255, 223, 0, 0.4);
        }

            .form-icon svg {
                width: 30px;
                height: 30px;
                color: #1a1a1a;
            }

        .form-title {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-subtitle {
            font-size: 0.95rem;
            color: #666;
            margin-bottom: 18px;
            font-weight: 500;
        }

        /* Wrapper do input + dropdown */
        .search-wrap {
            position: relative;
            margin-bottom: 14px;
        }

        .search-input {
            width: 100%;
            padding: 14px 44px 14px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
            font-weight: 500;
            color: #1a1a1a;
            background: #fff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            outline: none;
        }

            .search-input::placeholder {
                color: #999;
            }

            .search-input:focus {
                border-color: #009C3B;
                box-shadow: 0 0 0 4px rgba(0, 156, 59, 0.12);
            }

            .search-input.error {
                border-color: #e53935;
                box-shadow: 0 0 0 4px rgba(229, 57, 53, 0.12);
            }

        /* Ícone de lupa dentro do input */
        .search-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: #999;
            pointer-events: none;
        }

        /* Dropdown de cidades */
        .dropdown {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 12px;
            max-height: 220px;
            overflow-y: auto;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
            z-index: 10;
            display: none;
        }

            .dropdown.show {
                display: block;
            }

        .dropdown-item {
            padding: 10px 16px;
            font-size: 0.95rem;
            color: #333;
            cursor: pointer;
            transition: background 0.15s ease;
            font-weight: 500;
        }

            .dropdown-item:hover,
            .dropdown-item.active {
                background: #f5f5f5;
                color: #009C3B;
            }

            .dropdown-item.empty {
                color: #999;
                cursor: default;
                font-style: italic;
            }

        /* Scroll customizado do dropdown */
        .dropdown::-webkit-scrollbar {
            width: 6px;
        }

        .dropdown::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 3px;
        }

        /* Mensagem de erro */
        .error-msg {
            color: #e53935;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 10px;
            min-height: 18px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

            .error-msg.show {
                opacity: 1;
            }

        /* Botão CTA */
        .btn-cta {
            width: 100%;
            padding: 16px 20px;
            background: #FFDF00;
            color: #1a1a1a;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 6px 16px rgba(255, 223, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 54px;
        }

            .btn-cta:hover:not(:disabled) {
                background: #ebcc00;
                transform: translateY(-2px);
                box-shadow: 0 10px 22px rgba(255, 223, 0, 0.5);
            }

            .btn-cta:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-cta:disabled {
                cursor: not-allowed;
                opacity: 0.85;
            }

        /* Spinner */
        .spinner {
            width: 20px;
            height: 20px;
            border: 3px solid rgba(0, 0, 0, 0.2);
            border-top-color: #1a1a1a;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
        }

        .btn-cta.loading .spinner {
            display: inline-block;
        }

        .btn-cta.loading .btn-text {
            display: none;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===================== FOOTER ===================== */
        .footer {
            background: #002776;
            color: #fff;
            text-align: center;
            padding: 24px 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

            .footer strong {
                color: #FFDF00;
                font-weight: 700;
            }

        /* ===================== ANIMAÇÃO DE ENTRADA ===================== */
        @@keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ===================== RESPONSIVIDADE ===================== */
        @@media (max-width: 900px) {
            .hero {
                padding: 40px 20px;
            }

            .container {
                grid-template-columns: 1fr;
                gap: 48px;
                text-align: center;
            }
            /* Mobile: texto em cima, foto/formulário embaixo (ordem natural) */
            .badge {
                margin-bottom: 28px;
            }

            .title {
                margin-bottom: 28px;
            }

            .description {
                margin: 0 auto;
                font-size: 1.05rem;
                line-height: 1.6;
            }

            .photo-wrap,
            .form-card {
                max-width: 100%;
            }

            .form-icon {
                margin-left: auto;
                margin-right: auto;
            }

            .form-title,
            .form-subtitle {
                text-align: center;
            }

            .btn-cta {
                width: 100%;
            }
        }

        @@media (max-width: 480px) {
            .hero {
                padding: 32px 20px;
            }

            .form-card {
                padding: 22px 18px;
            }

            .badge {
                font-size: 11px;
                padding: 8px 14px;
            }
        }
    </style>
</head>
<body>

    <!-- ===================== SEÇÃO HERO ===================== -->
    <section class="hero">
        <div class="container">

            <!-- COLUNA ESQUERDA: Badge + Título + Descrição -->
            <div class="left">
                <div class="badge">
                    <!-- Ícone de seta -->
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                    MOVIMENTO OFICIAL
                </div>

                <h1 class="title">
                    FAÇA PARTE DA
                    <span class="highlight" id="tituloTropa">TROPA DO ANDRÉ</span>
                </h1>

                <p class="description">
                    Entre no grupo oficial da sua cidade e acompanhe em primeira mão todas as novidades, ações e informações importantes.
                </p>
            </div>

            <!-- COLUNA DIREITA: Foto + Card do Formulário -->
            <div class="right">

                <!-- Foto com borda amarela -->
                <div class="photo-wrap">
                    <img id="fotoPerfil" src="" alt="Filipe Barros - Deputado Federal" />
                </div>

                <!-- Card branco do formulário -->
                <div class="form-card">
                    <div class="form-icon">
                        <!-- Ícone de grupo de pessoas -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>

                    <h2 class="form-title">Entre Pra Tropa</h2>
                    <p class="form-subtitle">Selecione sua cidade</p>

                    <!-- Busca de cidade com dropdown -->
                    <div class="search-wrap">
                        <input type="text"
                               id="cityInput"
                               class="search-input"
                               placeholder="Digite sua cidade..."
                               autocomplete="off"
                               spellcheck="false"
                               aria-label="Buscar cidade" />
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>

                        <div class="dropdown" id="dropdown" role="listbox"></div>
                    </div>

                    <div class="error-msg" id="errorMsg">Selecione sua cidade primeiro</div>

                    <!-- Botão CTA com spinner -->
                    <button type="button" class="btn-cta" id="btnEntrar">
                        <span class="spinner"></span>
                        <span class="btn-text">Entrar no Grupo da Tropa</span>
                    </button>
                </div>
            </div>

        </div>
    </section>

    <!-- ===================== FOOTER ===================== -->
    <footer class="footer">
        © <span id="anoRodape">2026</span> <strong id="footerNome">Filipe Barros</strong> — <span id="footerCargo">Deputado Federal</span>. Todos os direitos reservados.
    </footer>

    <script src="~/Scripts/cidades.js?dc=@this.Request.QueryString["_dc"]"></script>
    <script>
        /* =======================================================
           CONFIGURAÇÕES CENTRALIZADAS
           ======================================================= */
        const CONFIG = {
            nome: "Filipe Barros e Moro",
            cargo: "Deputado Federal",
            anoRodape: 2026,
            fotoPerfil: "",
            // Link único usado por TODAS as cidades
            linkGrupo: "https://chat.whatsapp.com/C3ShiDCMTdtKlzWVmw9AfP?s=cl&p=a&mlu=1"
        };

        /* =======================================================
           MUNICÍPIOS
           ======================================================= */
        const CIDADES_PR = window.CIDADES_PR || [];

        /* =======================================================
           APLICAÇÃO DAS CONFIGURAÇÕES NO DOM
           ======================================================= */
        document.getElementById('tituloTropa').innerHTML = `TROPA DO<br>${CONFIG.nome.toUpperCase()}`;
        document.getElementById('anoRodape').textContent = CONFIG.anoRodape;
        document.getElementById('footerNome').textContent = CONFIG.nome;
        document.getElementById('footerCargo').textContent = CONFIG.cargo;

        const fotoPerfilEl = document.getElementById('fotoPerfil');
        const fotoPerfilFallback = fotoPerfilEl.getAttribute('src');
        if (CONFIG.fotoPerfil && CONFIG.fotoPerfil.trim()) {
            fotoPerfilEl.src = CONFIG.fotoPerfil;
            fotoPerfilEl.addEventListener('error', () => {
                fotoPerfilEl.src = fotoPerfilFallback;
            }, { once: true });
        }

        document.title = `Tropa do ${CONFIG.nome} | Movimento Oficial - ${CONFIG.cargo}`;

        /* =======================================================
           REFERÊNCIAS DOM
           ======================================================= */
        const cityInput = document.getElementById('cityInput');
        const dropdown = document.getElementById('dropdown');
        const btnEntrar = document.getElementById('btnEntrar');
        const errorMsg = document.getElementById('errorMsg');
        const searchWrap = cityInput.parentElement;

        let cidadeSelecionada = null;
        let activeIndex = -1;
        let currentItems = [];

        /* =======================================================
           APELIDOS / ERROS COMUNS
           ======================================================= */
        const CIDADE_ALIASES = {
            "rolandia": "Rolândia",
            "candito mota": "Candói",
            "celsia do pavao": "Santa Cecília do Pavão",
            "santa celia": "Santa Cecília do Pavão",
            "sao joao do itaperiu": "São João do Triunfo",
            "ibertioga": "Ibaiti",
            "diamante do oeste": "Diamante D'Oeste",
            "rancho alegre do oeste": "Rancho Alegre D'Oeste"
        };

        /* =======================================================
           NORMALIZAÇÃO PARA BUSCA
           ======================================================= */
        function normalize(str) {
            return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }

        /* =======================================================
           RESOLVE TEXTO DIGITADO PARA CIDADE OFICIAL
           ======================================================= */
        function resolverCidadeEntrada(valor) {
            const texto = valor.trim();
            if (!texto) return null;

            const exata = CIDADES_PR.find(c => normalize(c) === normalize(texto));
            if (exata) return exata;

            const porAlias = CIDADE_ALIASES[normalize(texto)];
            if (porAlias && CIDADES_PR.includes(porAlias)) return porAlias;

            return null;
        }

        /* =======================================================
           RENDERIZA O DROPDOWN
           ======================================================= */
        function renderDropdown(filter = '') {
            const normFilter = normalize(filter.trim());
            currentItems = CIDADES_PR.filter(c => normalize(c).includes(normFilter));

            dropdown.innerHTML = '';

            if (currentItems.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'dropdown-item empty';
                empty.textContent = 'Nenhuma cidade encontrada';
                dropdown.appendChild(empty);
            } else {
                currentItems.forEach((cidade, i) => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item';
                    item.textContent = cidade;
                    item.setAttribute('role', 'option');
                    item.dataset.index = i;

                    item.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        selecionarCidade(cidade);
                    });

                    dropdown.appendChild(item);
                });
            }

            activeIndex = -1;
            dropdown.classList.add('show');
        }

        /* =======================================================
           SELECIONA UMA CIDADE
           ======================================================= */
        function selecionarCidade(cidade) {
            cityInput.value = cidade;
            cidadeSelecionada = cidade;
            fecharDropdown();
            cityInput.classList.remove('error');
            errorMsg.classList.remove('show');
        }

        /* =======================================================
           FECHA O DROPDOWN
           ======================================================= */
        function fecharDropdown() {
            dropdown.classList.remove('show');
            activeIndex = -1;
        }

        /* =======================================================
           ATUALIZA ITEM ATIVO (navegação por teclado)
           ======================================================= */
        function atualizarItemAtivo() {
            const items = dropdown.querySelectorAll('.dropdown-item:not(.empty)');
            items.forEach((el, i) => {
                el.classList.toggle('active', i === activeIndex);
                if (i === activeIndex) el.scrollIntoView({ block: 'nearest' });
            });
        }

        /* =======================================================
           EVENTOS DO INPUT
           ======================================================= */
        cityInput.addEventListener('input', () => {
            cidadeSelecionada = null;
            renderDropdown(cityInput.value);
        });

        cityInput.addEventListener('focus', () => {
            renderDropdown(cityInput.value);
        });

        cityInput.addEventListener('keydown', (e) => {
            const items = dropdown.querySelectorAll('.dropdown-item:not(.empty)');

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (!dropdown.classList.contains('show')) {
                    renderDropdown(cityInput.value);
                    return;
                }
                if (items.length === 0) return;
                activeIndex = (activeIndex + 1) % items.length;
                atualizarItemAtivo();
            }
            else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (items.length === 0) return;
                activeIndex = activeIndex <= 0 ? items.length - 1 : activeIndex - 1;
                atualizarItemAtivo();
            }
            else if (e.key === 'Enter') {
                if (activeIndex >= 0 && currentItems[activeIndex]) {
                    e.preventDefault();
                    selecionarCidade(currentItems[activeIndex]);
                } else {
                    const resolvida = resolverCidadeEntrada(cityInput.value);
                    if (resolvida) {
                        e.preventDefault();
                        selecionarCidade(resolvida);
                    }
                }
            }
            else if (e.key === 'Escape') {
                fecharDropdown();
                cityInput.blur();
            }
        });

        /* =======================================================
           FECHA O DROPDOWN AO CLICAR FORA
           ======================================================= */
        document.addEventListener('click', (e) => {
            if (!searchWrap.contains(e.target)) fecharDropdown();
        });

        /* =======================================================
           BOTÃO "ENTRAR NO GRUPO DA TROPA"
           Todas as cidades usam o mesmo link (CONFIG.linkGrupo).
           FIX MOBILE: window.open() chamado de forma síncrona,
           dentro do evento de clique, para não ser bloqueado
           pelo iOS Safari / Android.
           ======================================================= */
        btnEntrar.addEventListener('click', () => {
            // Tenta resolver automaticamente por nome aproximado / apelido
            const cidadeResolvida = resolverCidadeEntrada(cityInput.value);
            if (cidadeResolvida) selecionarCidade(cidadeResolvida);

            // Nenhuma cidade válida selecionada
            if (!cidadeSelecionada || !CIDADES_PR.includes(cidadeSelecionada)) {
                mostrarErro();
                return;
            }

            // Link único para todas as cidades
            const link = CONFIG.linkGrupo;

            // Abre AQUI — síncrono dentro do click — para funcionar no mobile
            if (link && link.trim()) {
                window.open(link, '_blank', 'noopener,noreferrer');
            }

            // Feedback visual de loading
            btnEntrar.classList.add('loading');
            btnEntrar.disabled = true;

            setTimeout(() => {
                btnEntrar.classList.remove('loading');
                btnEntrar.disabled = false;
            }, 1000);
        });

        /* =======================================================
           MOSTRA MENSAGEM DE ERRO (some após 3s)
           ======================================================= */
        function mostrarErro() {
            cityInput.classList.add('error');
            errorMsg.classList.add('show');
            cityInput.focus();

            setTimeout(() => {
                cityInput.classList.remove('error');
                errorMsg.classList.remove('show');
            }, 3000);
        }
    </script>

</body>
</html>
