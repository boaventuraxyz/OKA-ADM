@using adm.Models
@model List<Assinatura>

@{ ViewBag.Title = "Assinaturas - " + ViewBag.CampanhaTitulo; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Assinaturas</h2>
        <small class="text-muted">@ViewBag.CampanhaTitulo</small>
    </div>
    <a href="@Url.Action("Index", "Campanha")" class="btn btn-outline-secondary">Voltar</a>
</div>

<p class="text-muted mb-3">Total: <strong>@Model.Count</strong> assinaturas</p>

<table class="table table-bordered table-hover">
    <thead class="thead-light">
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>Estado</th>
            <th>Assinado em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.NomeAssinante</td>
                <td>@(a.EmailAssinante ?? "-")</td>
                <td>@(a.NumeroAssinante ?? "-")</td>
                <td>@(a.CidadeAssinante ?? "-")</td>
                <td>@(a.EstadoAssinante ?? "-")</td>
                <td>@(a.AssinadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                <td>
                    <a href="@Url.Action("Details", "Assinatura", new { id = a.Id })"
                       class="btn btn-sm btn-outline-secondary">Ver</a>
                    
                </td>
            </tr>
        }
    </tbody>
</table>