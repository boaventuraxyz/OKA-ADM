@using adm.Models
@model List<Assinatura>

@{ ViewBag.Title = "Assinaturas - " + ViewBag.CampanhaTitulo; }

<div class="page-toolbar">
    <div>
        <h2>Assinaturas</h2>
        <small class="text-muted page-toolbar-subtitle">@ViewBag.CampanhaTitulo</small>
    </div>
    <div class="page-actions">
        <a href="@Url.Action("Index", "Campanha")" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>

<p class="text-muted mb-3">Total: <strong>@Model.Count</strong> assinaturas</p>

<div class="card section-card table-card">
    <div class="table-responsive">
        <table class="table table-bordered table-hover admin-table">
            <thead class="thead-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>Cidade</th>
                    <th>Estado</th>
                    <th>Assinado em</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td data-label="Nome">@a.NomeAssinante</td>
                        <td data-label="E-mail">@(a.EmailAssinante ?? "-")</td>
                        <td data-label="Telefone">@(a.NumeroAssinante ?? "-")</td>
                        <td data-label="Cidade">@(a.CidadeAssinante ?? "-")</td>
                        <td data-label="Estado">@(a.EstadoAssinante ?? "-")</td>
                        <td data-label="Assinado em">@(a.AssinadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td data-label="Acoes" class="table-actions">
                            <a href="@Url.Action("Details", "Assinatura", new { id = a.Id })"
                               class="btn btn-sm btn-outline-secondary">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
