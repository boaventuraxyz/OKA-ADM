@using adm.Models
@Html.AntiForgeryToken()
@{
    var campannha = ViewBag.Campanha as Campanha;
    var assinatuas = ViewBag.Assinaturas as List<Assinatura>;
    var textoApoio = campannha?.TextoForm != null ? campannha?.TextoForm : "Texto Apoio";
    var assinaturaCampanha = assinatuas?.Count() ?? 0;

    var cultura = new System.Globalization.CultureInfo("pt-BR");
    var totalAssinaturas = assinaturaCampanha.ToString("N0", cultura);
    var totalRestante = ((campannha.AssinaturaMeta ?? 0) - assinaturaCampanha).ToString("N0", cultura);
    var meta = (campannha.AssinaturaMeta ?? 0).ToString("N0", cultura);
}
<style>
    @@import url('https://api.fontshare.com/v2/css?f[]=clash-display@@400,500,700&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
    }

    .form-card {
        font-family: 'Montserrat', sans-serif;
        background: #1A2338;
        border: 1px solid #2A3A58;
        border-radius: 16px;
        padding: 30px 26px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        box-shadow: 0 24px 60px rgba(0,0,0,.45);
        color: #E8EAF0;
    }

        .form-card h1, .form-card h2, .form-card .card-title {
            font-family: 'Clash Display', sans-serif;
        }

        .form-card .card-header {
            text-align: center;
        }

        .form-card .card-live {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #E05A5A;
            margin-bottom: 10px;
        }

        .form-card .card-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #E05A5A;
            animation: pulseFc 1.4s ease-in-out infinite;
        }

    @@keyframes pulseFc {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .5;
            transform: scale(.75);
        }
    }

    .form-card .card-title {
        font-size: 20px;
        font-weight: 600;
        color: #FFFFFF;
        line-height: 1.2;
        margin-bottom: 6px;
    }

    .form-card .card-desc {
        font-size: 13px;
        color: #7A8BAA;
        line-height: 1.5;
    }

        .form-card .card-desc strong {
            color: #E8C84A;
        }

    .form-card .live-count-display {
        background: rgba(232,200,74,.06);
        border: 1px solid rgba(232,200,74,.18);
        border-radius: 10px;
        padding: 20px 16px;
        text-align: center;
    }

    .form-card .live-num {
        font-size: 52px;
        font-weight: 800;
        color: #E8C84A;
        line-height: 1;
        letter-spacing: -1px;
    }

    .form-card .live-pessoas {
        font-size: 15px;
        color: #E8EAF0;
        font-weight: 600;
        margin-top: 6px;
    }

        .form-card .live-pessoas span {
            color: #7A8BAA;
            font-weight: 400;
        }

    .form-card .remaining-text {
        font-size: 13px;
        color: #E05A5A;
        font-weight: 700;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .form-card .progress-bar-track {
        width: 100%;
        height: 10px;
        background: rgba(255,255,255,.08);
        border-radius: 999px;
        overflow: hidden;
    }

    .form-card .progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #E8C84A 0%, #f5df7f 100%);
        border-radius: 999px;
        transition: width .6s ease;
    }

    .form-card .progress-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
    }

    .form-card .progress-pct {
        font-size: 11px;
        font-weight: 700;
        color: #E8C84A;
        background: rgba(232,200,74,.12);
        padding: 2px 7px;
        border-radius: 4px;
    }

    .form-card .progress-count {
        font-size: 13px;
        color: #E8EAF0;
        font-weight: 600;
    }

        .form-card .progress-count span {
            color: #7A8BAA;
            font-weight: 400;
        }

    .form-card .form-fields {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .form-card .form-input {
        width: 100%;
        background: #1E2C44;
        border: 1px solid #2A3A58;
        border-radius: 8px;
        padding: 13px 16px;
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
        color: #E8EAF0;
        outline: none;
        transition: border-color .2s ease;
    }

        .form-card .form-input::placeholder {
            color: #7A8BAA;
        }

        .form-card .form-input:focus {
            border-color: #E8C84A;
        }

        .form-card .form-input.error {
            border-color: #E05A5A;
        }

    .form-card .field-error {
        font-size: 11px;
        color: #E05A5A;
        font-weight: 600;
        margin-top: -6px;
        display: none;
    }

    .form-card .endereco-row {
        display: grid;
        grid-template-columns: 1fr 100px;
        gap: 10px;
    }

    .form-card .btn-sign {
        width: 100%;
        background: #E8C84A;
        color: #0D111A;
        border: none;
        border-radius: 8px;
        padding: 15px;
        font-family: 'Montserrat', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity .2s ease, transform .2s ease;
    }

        .form-card .btn-sign:hover:not(:disabled) {
            transform: translateY(-1px);
        }

        .form-card .btn-sign:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .form-card .form-footer {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: center;
        font-size: 12px;
        color: #7A8BAA;
        text-align: center;
    }

    /* Responsivo dentro do card */
    @@media (max-width: 900px) {
        .form-card {
            padding: 22px 20px;
            gap: 14px;
        }

            .form-card .card-title {
                font-size: 16px;
            }

            .form-card .card-desc {
                font-size: 12px;
            }

            .form-card .live-num {
                font-size: 36px;
            }

            .form-card .live-pessoas {
                font-size: 13px;
            }

            .form-card .remaining-text {
                font-size: 11px;
            }

            .form-card .live-count-display {
                padding: 14px 12px;
            }

            .form-card .form-input {
                padding: 11px 12px;
                font-size: 13px;
            }

            .form-card .btn-sign {
                padding: 13px;
                font-size: 14px;
            }

            .form-card .progress-pct {
                font-size: 10px;
            }

            .form-card .progress-count {
                font-size: 11px;
            }

            .form-card .form-footer {
                font-size: 11px;
            }

            .form-card .endereco-row {
                grid-template-columns: 1fr 80px;
                gap: 8px;
            }
    }

    @@media (max-width: 480px) {
        .form-card {
            padding: 18px 16px;
            border-radius: 12px;
            gap: 12px;
        }

            .form-card .card-title {
                font-size: 15px;
            }

            .form-card .card-desc {
                font-size: 11px;
            }

            .form-card .live-num {
                font-size: 30px;
            }

            .form-card .form-input {
                padding: 10px 10px;
                font-size: 12px;
            }

            .form-card .btn-sign {
                padding: 12px;
                font-size: 13px;
            }

            .form-card .endereco-row {
                grid-template-columns: 1fr 70px;
                gap: 6px;
            }

            .form-card .field-error {
                font-size: 10px;
            }

            .form-card .remaining-text {
                font-size: 10px;
            }

            .form-card .progress-pct {
                font-size: 9px;
            }

            .form-card .progress-count {
                font-size: 10px;
            }

            .form-card .live-count-display {
                padding: 12px 10px;
            }

            .form-card .form-footer {
                font-size: 10px;
            }

    
        .progress-bar-track {
            width: 100%;
            height: 10px;
            background: #2a2a2a;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #22c55e, #4ade80);
            transition: width 0.6s ease;
        }

/* Mobile: ocupa quase a largura toda, fica embaixo e centralizado */
@@media (max-width: 600px) {
    .toast {
        left: 12px;
        right: 12px;
        bottom: 12px;
        max-width: none;
        min-width: 0;
        font-size: 13px;
        padding: 12px 16px;
        text-align: center;
    }
}
    }
</style>
<div class="form-card">
    <input hidden="hidden" value="@(campannha.Id)" id="campanhaID" />
    <input hidden="hidden" value="@(campannha.CandidatoId)" id="campanhaCandidatoID" />

    <div class="card-header">
        <div class="card-live">
            <span class="card-live-dot"></span>
            Assine agora
        </div>

        <div class="card-title">@(textoApoio)</div>

        <div class="card-desc">
            Precisamos de <strong>@(meta) assinaturas</strong> para protocolar a solicitação.
        </div>
    </div>

    <div class="live-count-display">
        <div class="live-num" id="liveNum">@(totalAssinaturas)</div>
        <div class="live-pessoas">pessoas já assinaram</div>
        <div class="remaining-text" id="remainingText">Faltam @(totalRestante) para a meta</div>
    </div>

    <div class="progress-bar-track">
        <div class="progress-bar-fill" id="progressFill"></div>
    </div>

    <div class="progress-info">
        <span class="progress-pct" id="progressPct">0%</span>
        <span class="progress-count" id="progressCount">
            @(totalAssinaturas) <span>/ Meta: @(meta)</span>
        </span>
    </div>

    <form class="form-fields" id="formAssinar" autocomplete="on"
          onsubmit="event.preventDefault(); handleSign();">

        <input id="nome" class="form-input" type="text"
               placeholder="Seu nome completo" name="name" />
        <span class="field-error" id="erroNome">Informe seu nome completo</span>

        <input id="tel" class="form-input" type="tel"
               placeholder="WhatsApp com DDD" name="phone" />
        <span class="field-error" id="erroTel">Informe um telefone válido</span>

        <input id="mail" class="form-input" type="email"
               placeholder="Seu melhor e-mail" name="email" />
        <span class="field-error" id="erroMail">
            Informe um e-mail válido (ex: nome@@email.com)
        </span>
        <input id="cep" class="form-input" type="text"
               placeholder="CEP (00000-000)" maxlength="9" />
        <span class="field-error" id="erroCep">
            Informe um CEP válido (00000-000)
        </span>
        <div class="endereco-row">
            <input id="cidade" hidden type="text" />
            <input id="estado" hidden type="text" />
            <input id="rua" readonly="readonly" class="form-input" type="text"
                   placeholder="Rua / Av. / Travessa..." />

            <input id="numero" class="form-input" type="text"
                   placeholder="Nº" />
        </div>
        <span class="field-error" id="erroRua">Informe o endereço e o número</span>

        <input id="complemento" class="form-input" type="text"
               placeholder="Apartamento, bloco, casa" />

        <button class="btn-sign" type="submit">
            Assinar agora
        </button>
    </form>

    <div class="form-footer">
        <span>Leva menos de 1 minuto</span>
        <span>Seus dados estão protegidos conforme a LGPD</span>
    </div>
</div>

<script src="~/Scripts/forms.js?dc=@this.Request.QueryString["_dc"]"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const total = @assinaturaCampanha;
        const meta = @campannha.AssinaturaMeta;

        atualizarProgresso(total, meta);
    });
</script>

