@using adm.Models
@model Campanha

@{
    ViewBag.Title = "Editar Campanha";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Editar campanha</h2>
    @Html.ActionLink("Voltar", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

@using (Html.BeginForm("Edit", "Campanha", FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="card p-4 mb-3">
    <h6 class="text-muted text-uppercase mb-3" style="font-size:11px; letter-spacing:.05em;">
        Informações gerais
    </h6>

    <div class="form-group">
        <label>Título *</label>
        <input name="Titulo" class="form-control" value="@Model.Titulo" required />
    </div>

    <div class="form-group">
        <label>Descrição</label>
        <textarea name="Descricao" class="form-control" rows="3">@Model.Descricao</textarea>
    </div>

    <div class="form-group">
        <label>ID da planilha</label>
        <input name="IdPlanilha" class="form-control" value="@Model.IdPlanilha" />
    </div>
    <div class="form-group">
        <label>Metas de Assinatura</label>
        <input name="AssinaturaMeta" class="form-control" value="@(Model.AssinaturaMeta)"
               placeholder="Metas de assinatura da campanha." />
    </div>
    <div class="form-group">
        <label>Texto Apoio Contador</label>
        <input name="TextoForm" class="form-control" value="@(Model.TextoForm)"
               placeholder="Texto de apoio do contador" />
    </div>
    <div class="form-group">
        <label>Url Formulário Campanha</label>
        <input readonly="readonly" class="form-control" value="/Formulario/@(Model.Id)"/>
    </div>
</div>

    <div class="card p-4 mb-3">
        <h6 class="text-muted text-uppercase mb-3" style="font-size:11px; letter-spacing:.05em;">
            Período
        </h6>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Início</label>
                    <input name="InicioEm" type="datetime-local" class="form-control"
                           value="@(Model.InicioEm?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Fim</label>
                    <input name="FimEm" type="datetime-local" class="form-control"
                           value="@(Model.FimEm?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-4">
        <h6 class="text-muted text-uppercase mb-3" style="font-size:11px; letter-spacing:.05em;">
            Configurações
        </h6>
        <div class="form-check">
            <input name="Ativa" type="checkbox" class="form-check-input" value="true"
                   @(Model.Ativa == true ? "checked" : "") />
            <label class="form-check-label">Campanha ativa</label>
        </div>
    </div>

    <div class="d-flex justify-content-end">
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary mr-2" })
        <button type="submit" class="btn btn-dark">Salvar alterações</button>
    </div>
}