@using adm.Models
@model List<Candidato>

@{ ViewBag.Title = "Candidatos"; }

<div class="page-toolbar">
    <h2>Candidatos</h2>
    <div class="page-actions">
        <a href="@Url.Action("Create", "Candidato")" class="btn btn-dark">+ Novo candidato</a>
    </div>
</div>

<div class="card section-card table-card">
    <div class="table-responsive">
        <table class="table table-bordered table-hover admin-table">
            <thead class="thead-light">
                <tr>
                    <th>Nome</th>
                    <th>Partido</th>
                    <th>Cargo</th>
                    <th>Estado</th>
                    <th>Municipio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td data-label="Nome">@c.Nome</td>
                        <td data-label="Partido">@(c.Partido ?? "-")</td>
                        <td data-label="Cargo">@(c.Cargo ?? "-")</td>
                        <td data-label="Estado">@(c.Estado ?? "-")</td>
                        <td data-label="Municipio">@(c.Municipio ?? "-")</td>
                        <td data-label="Acoes" class="table-actions">
                            <div class="row-actions">
                                <a href="@Url.Action("Edit", "Candidato", new { id = c.Id })"
                                   class="btn btn-sm btn-outline-secondary">Editar</a>
                                @using (Html.BeginForm("Delete", "Candidato", new { id = c.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Excluir este candidato?')">
                                        Excluir
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
