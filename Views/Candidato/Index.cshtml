@using adm.Models
@model List<Candidato>

@{ ViewBag.Title = "Candidatos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Candidatos</h2>
    <a href="@Url.Action("Create", "Candidato")" class="btn btn-dark">+ Novo candidato</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="thead-light">
        <tr>
            <th>Nome</th>
            <th>Partido</th>
            <th>Cargo</th>
            <th>Estado</th>
            <th>Município</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nome</td>
                <td>@(c.Partido ?? "-")</td>
                <td>@(c.Cargo ?? "-")</td>
                <td>@(c.Estado ?? "-")</td>
                <td>@(c.Municipio ?? "-")</td>
                <td>
                    <a href="@Url.Action("Edit", "Candidato", new { id = c.Id })"
                       class="btn btn-sm btn-outline-secondary">Editar</a>
                    @using (Html.BeginForm("Delete", "Candidato", new { id = c.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Excluir este candidato?')">
                            Excluir
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>