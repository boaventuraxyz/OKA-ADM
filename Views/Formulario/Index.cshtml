@model adm.Models.Campanha

@{
    Layout = null;
    ViewBag.Title = "Formulario";
    var htmlBackGroundModel = ViewData["htmlDecod"].ToString();
    var temHtml = !string.IsNullOrWhiteSpace(htmlBackGroundModel);
}

<link href="@Url.Content("~/Content/formulario.css")" rel="stylesheet" />

<style>
    html, body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .pagina-campanha {
        position: relative;
        width: 100%;
        /* deixa o wrapper crescer conforme o conteúdo (form ou fundo) */
        min-height: 100vh;
        overflow: hidden;
    }

    /* FUNDO — agora estica conforme o formulário cresce */
    .conteudo-campanha {
        position: relative;
        width: 100%;
        min-height: 100vh;
        background: #0D111A;
        /* IMPORTANTE: removido o overflow:hidden para permitir que o conteúdo
           interno seja "esticado" via flex e que filhos cresçam */
        display: flex;
        flex-direction: column;
    }

        /* Faz o conteúdo HTML interno esticar verticalmente
           para acompanhar a altura do .pagina-campanha (que cresce com o form) */
        .conteudo-campanha > * {
            width: 100%;
            flex: 1 0 auto; /* estica para baixo se sobrar espaço */
            min-height: 100vh; /* nunca menor que a viewport */
        }

    /* FORM SOBREPOSTO — exatamente na metade direita */
    .formulario-lateral {
        position: absolute;
        top: 10%;
        right: 0;
        width: 40%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        z-index: 999;
        pointer-events: none;
        padding: 40px 30px;
        box-sizing: border-box;
    }

        .formulario-lateral > .form-card {
            pointer-events: all;
            width: 100%;
            max-width: 420px;
            position: static;
            margin: 0;
        }

    .fallback-campanha {
        background-color: #3d3d3d;
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    /* MOBILE — empilha tudo */
    @@media (max-width: 900px) {
        .pagina-campanha {
            min-height: auto;
        }

        .conteudo-campanha {
            min-height: auto;
            display: block;
        }

            .conteudo-campanha > * {
                min-height: auto;
                flex: none;
            }

        .formulario-lateral {
            position: relative;
            width: 100%;
            height: auto;
            min-height: auto;
            pointer-events: all;
            padding: 20px;
            top: 0;
        }

            .formulario-lateral > .form-card {
                max-width: 100%;
            }
    }
</style>

<div class="pagina-campanha">

    <!-- FUNDO -->
    <div class="conteudo-campanha">
        @if (temHtml)
        {
            @Html.Raw(htmlBackGroundModel)
        }
        else
        {
            <div class="fallback-campanha">
                <strong>Sem conteúdo HTML</strong>
            </div>
        }
    </div>

    <!-- FORM SOBREPOSTO NA METADE DIREITA -->
    <div class="formulario-lateral">
        @Html.Partial("_formulario")
    </div>

</div>

<script src="~/Scripts/forms.js?dc=@this.Request.QueryString["_dc"]"></script>
@Html.AntiForgeryToken()

<!-- Script que mede o formulário e estica o fundo se necessário -->
<script>
    (function () {
        function ajustarAlturaFundo() {
            // Só ajusta no desktop
            if (window.innerWidth <= 900) {
                document.querySelector('.pagina-campanha').style.minHeight = '';
                document.querySelector('.conteudo-campanha').style.minHeight = '';
                return;
            }

            var pagina = document.querySelector('.pagina-campanha');
            var fundo = document.querySelector('.conteudo-campanha');
            var formLateral = document.querySelector('.formulario-lateral');
            var formCard = formLateral ? formLateral.querySelector('.form-card') : null;

            if (!pagina || !fundo || !formLateral) return;

            // Altura real necessária pelo formulário:
            // offsetTop do .formulario-lateral (10%) + altura do card + folga de padding
            var alturaCard = formCard ? formCard.offsetHeight : formLateral.offsetHeight;
            var topo = formLateral.offsetTop;
            var paddingExtra = 80; // respiro top/bottom

            var alturaNecessaria = topo + alturaCard + paddingExtra;
            var alturaViewport = window.innerHeight;

            // Usa o maior entre viewport e o que o form precisa
            var alturaFinal = Math.max(alturaViewport, alturaNecessaria);

            pagina.style.minHeight = alturaFinal + 'px';
            fundo.style.minHeight = alturaFinal + 'px';
        }

        // Executa na carga, após imagens, e em resize
        window.addEventListener('load', ajustarAlturaFundo);
        window.addEventListener('resize', ajustarAlturaFundo);

        // Observa mudanças no formulário (campos dinâmicos, validações, etc.)
        document.addEventListener('DOMContentLoaded', function () {
            ajustarAlturaFundo();

            var alvo = document.querySelector('.formulario-lateral');
            if (alvo && 'ResizeObserver' in window) {
                var ro = new ResizeObserver(ajustarAlturaFundo);
                ro.observe(alvo);
            }
        });
    })();
</script>