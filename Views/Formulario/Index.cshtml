@model adm.Models.Campanha

@{
    Layout = null;
    ViewBag.Title = "Formulario";
    var htmlBackGroundModel = ViewData["htmlDecod"].ToString();
    var temHtml = !string.IsNullOrWhiteSpace(htmlBackGroundModel);
}

<link href="@Url.Content("~/Content/formulario.css")" rel="stylesheet" />

<style>
    html, body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .pagina-campanha {
        position: relative;
        min-height: 100vh;
        width: 100%;
        overflow: hidden;
    }

    /* FUNDO ocupa a tela inteira */
    .conteudo-campanha {
        position: relative;
        width: 100%;
        overflow: hidden;
        min-height: 100vh;
        background: #0D111A;
    }

        .conteudo-campanha > * {
            width: 100%;
            min-height: 100vh;
        }

    /* FORM SOBREPOSTO — exatamente na metade direita */
    .formulario-lateral {
        position: absolute;
        top: 10%;
        overflow: hidden;
        right: 0;
        width: 40%; /* metade exata da tela */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
        pointer-events: none; /* permite clicar no fundo */
        padding: 40px 30px;
    }

        /* O CARD do form recebe os cliques */
        .formulario-lateral > .form-card {
            pointer-events: all;
            width: 100%;
            max-width: 420px;
            position: static; /* sobrescreve o sticky do shared */
            margin: 0;
        }

    .fallback-campanha {
        background-color: #3d3d3d;
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    /* MOBILE — empilha tudo */
    @@media (max-width: 900px) {
        .pagina-campanha {
            min-height: auto;
        }

        .conteudo-campanha {
            min-height: auto;
        }

            .conteudo-campanha > * {
                min-height: auto;
            }

        .formulario-lateral {
            position: relative;
            width: 100%;
            height: auto;
            min-height: auto;
            pointer-events: all;
            padding: 20px;
        }

            .formulario-lateral > .form-card {
                max-width: 100%;
            }
    }
</style>

<div class="pagina-campanha">

    <!-- FUNDO -->
    <div class="conteudo-campanha">
        @if (temHtml)
        {
            @Html.Raw(htmlBackGroundModel)
        }
        else
        {
            <div class="fallback-campanha">
                <strong>Sem conteúdo HTML</strong>
            </div>
        }
    </div>

    <!-- FORM SOBREPOSTO NA METADE DIREITA -->
    <div class="formulario-lateral">
        @Html.Partial("_formulario")
    </div>

</div>

<script src="~/Scripts/forms.js?dc=@this.Request.QueryString["_dc"]"></script>
@Html.AntiForgeryToken()


