@{
    Layout = null;
    ViewBag.Title = "Muitas tentativas";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Muitas tentativas</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 24px 16px;
            background-color: #f8f9fa;
        }

        .container {
            width: 100%;
            max-width: 420px;
            text-align: center;
            padding: 32px 24px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.08);
        }

        h1 {
            color: #e74c3c;
            font-size: clamp(42px, 12vw, 56px);
            margin: 0 0 8px;
        }

        h2 {
            color: #333;
            margin: 0 0 12px;
            font-size: 24px;
        }

        p {
            color: #666;
            margin: 0;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>429</h1>
        <h2>Muitas tentativas!</h2>
        <p>Você fez requisições demais em pouco tempo.<br />Aguarde um momento e tente novamente.</p>
    </div>
</body>
</html>
