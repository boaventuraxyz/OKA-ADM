@using adm.Models
@{
    ViewBag.Title = "Dashboard";

    var campanhas = ViewBag.Campanhas as List<Campanha> ?? new List<Campanha>();
    var campanhasTotal = campanhas.Count.ToString();
    var campanhasAtivas = campanhas.Count(x => x.Ativa == true).ToString();

    var assinaturas = ViewBag.Assinaturas as List<Assinatura> ?? new List<Assinatura>();
    var assinaturasTotal = assinaturas.Count.ToString();

    var candidatos = ViewBag.Candidatos as List<Candidato> ?? new List<Candidato>();
    var candidatosTotal = candidatos.Count.ToString();
}

<div class="row mb-4">
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card text-center p-3 section-card h-100">
            <div class="text-muted small">Campanhas ativas</div>
            <div style="font-size:28px; font-weight:600;">@(campanhasAtivas)</div>
            <div class="text-muted" style="font-size:11px;">de @(campanhasTotal) no total</div>
        </div>
    </div>
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card text-center p-3 section-card h-100">
            <div class="text-muted small">Candidatos</div>
            <div style="font-size:28px; font-weight:600;">@(candidatosTotal)</div>
            <div class="text-muted" style="font-size:11px;">cadastrados</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3 section-card h-100">
            <div class="text-muted small">Assinaturas</div>
            <div style="font-size:28px; font-weight:600;">@(assinaturasTotal)</div>
            <div class="text-muted" style="font-size:11px;">respostas coletadas</div>
        </div>
    </div>
</div>

<div class="page-toolbar">
    <h5>Campanhas recentes</h5>
    <div class="page-actions">
        @Html.ActionLink("Ver todas", "Index", "Campanha", null, new { @class = "btn btn-sm btn-outline-secondary" })
    </div>
</div>

<div class="card section-card table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 admin-table">
            <thead class="thead-light">
                <tr>
                    <th>Titulo</th>
                    <th>Status</th>
                    <th>Inicio</th>
                    <th>Fim</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in campanhas)
                {
                    <tr>
                        <td data-label="Titulo">@c.Titulo</td>
                        <td data-label="Status">
                            @if (c.Ativa == true)
                            {
                                <span class="badge badge-success" style="background-color: #009613">Ativa</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary" style="background-color:#808080">Inativa</span>
                            }
                        </td>
                        <td data-label="Inicio">@(c.InicioEm?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td data-label="Fim">@(c.FimEm?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td data-label="Acoes" class="table-actions">
                            @Html.ActionLink("Ver", "Edit", "Campanha", new { id = c.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
