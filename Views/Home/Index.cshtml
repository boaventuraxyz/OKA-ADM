@using adm.Models
@{
    ViewBag.Title = "Dashboard";

    var campanhas = ViewBag.Campanhas as List<Campanha>;
    var campanhasTotal = campanhas.Count().ToString();
    var campanhasAtivas = campanhas.Where(x => x.Ativa == true).Count().ToString();

    var assinaturas = ViewBag.Assinaturas as List<Assinatura>;
    var assinaturasTotal = assinaturas.Count().ToString();

    var candidatos = ViewBag.Candidatos as List<Candidato>;
    var candidatosTotal = candidatos.Count().ToString();
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="text-muted small">Campanhas ativas</div>
            <div style="font-size:28px; font-weight:600;">@(campanhasAtivas)</div>
            <div class="text-muted" style="font-size:11px;">de @(campanhasTotal) no total</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="text-muted small">Candidatos</div>
            <div style="font-size:28px; font-weight:600;">@(candidatosTotal)</div>
            <div class="text-muted" style="font-size:11px;">cadastrados</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="text-muted small">Assinaturas</div>
            <div style="font-size:28px; font-weight:600;">@(assinaturasTotal)</div>
            <div class="text-muted" style="font-size:11px;">respostas coletadas</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Campanhas recentes</h5>
    @Html.ActionLink("Ver todas", "Index", "Campanha", null, new { @class = "btn btn-sm btn-outline-secondary" })
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="thead-light">
            <tr>
                <th>Título</th>
                <th>Status</th>
                <th>Início</th>
                <th>Fim</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (campanhas != null)
            {
                foreach (var c in campanhas)
                {
                    <tr>
                        <td>@c.Titulo</td>
                        <td>
                            @if (c.Ativa == true)
                            {<span class="badge badge-success" style="background-color: #009613">Ativa</span> }
                            else
                            { <span class="badge badge-secondary" style="background-color:#808080">Inativa</span>}
                        </td>
                        <td>@(c.InicioEm?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(c.FimEm?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@Html.ActionLink("Ver", "Edit", "Campanha", new { id = c.Id }, new { @class = "btn btn-sm btn-outline-secondary" })</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>